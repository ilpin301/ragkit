### LLM: Z.ai GLM coding-plan endpoint (OpenAI-compatible)
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.z.ai/api/coding/paas/v4
LLM_BINDING_API_KEY=__LLM_API_KEY__
LLM_MODEL=glm-5.2

### Vision model for images inside documents
VLM_PROCESS_ENABLE=true
VLM_LLM_BINDING=openai
VLM_LLM_BINDING_HOST=https://api.z.ai/api/coding/paas/v4
VLM_LLM_BINDING_API_KEY=__LLM_API_KEY__
VLM_LLM_MODEL=glm-4.5v

### Embeddings: local Ollama (the Z.ai plan has no embedding endpoint).
### EMBEDDING_MODEL and EMBEDDING_DIM can never change after the first ingest.
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192

### Server
HOST=0.0.0.0
PORT=__PORT__
LIGHTRAG_API_KEY=__SERVER_KEY__
WEBUI_TITLE=__NAME__
SUMMARY_LANGUAGE=English
COMPOSE_PROJECT_NAME=__PROJECT__

### Vector backend. NanoVectorDBStorage rewrites all three vdb_*.json on every
### document flush; QdrantVectorDBStorage writes only the changed rows.
### Switching an EXISTING base needs migrate_nano_to_qdrant.py first - flipping
### this alone points the server at an empty index.
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
### Host-side URL, used by rag_ingest.py. The container gets http://qdrant:6333
### from docker-compose.yml instead. Must be unique per base on this machine.
QDRANT_PORT=__QDRANT_PORT__
QDRANT_URL=http://127.0.0.1:__QDRANT_PORT__
